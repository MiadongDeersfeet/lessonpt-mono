worker_processes 1;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  # No query strings, invitation tokens, Authorization or cookies in access logs.
  access_log off;
  client_body_temp_path /tmp/nginx/client;
  proxy_temp_path /tmp/nginx/proxy;
  client_header_timeout 15s;
  client_body_timeout 30s;
  send_timeout 30s;
  keepalive_timeout 15s;
  limit_req_status 429;
  limit_conn_status 429;
  # Fixed per-service keys: do not trust a client-supplied forwarding header.
  map $uri $service_key { default lessonpt; }
  map $request_method $upload_key { default ""; POST lessonpt; PUT lessonpt; }
  limit_req_zone $service_key zone=api:1m rate=10r/s;
  limit_req_zone $service_key zone=auth:1m rate=30r/m;
  limit_req_zone $service_key zone=health:1m rate=2r/s;
  limit_conn_zone $service_key zone=connections:1m;
  limit_conn_zone $upload_key zone=uploads:1m;
  server {
    listen ${PORT};
    server_name _;
    root /app/public;
    client_max_body_size 55m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;
    location = /healthz {
      limit_req zone=health burst=5 nodelay;
      proxy_pass http://127.0.0.1:8080/actuator/health;
      proxy_connect_timeout 2s;
      proxy_read_timeout 4s;
    }
    location /actuator { return 404; }
    # Teacher-only preview until the replacement student authentication is designed.
    location ~ ^/api/v1/(student-access/[^/]+/otp(/verify)?|student-login/otp(/verify)?)$ {
      default_type application/json;
      return 503 '{"status":503,"code":"STUDENT_LOGIN_DISABLED","message":"학생 이메일 인증은 현재 제공하지 않습니다."}';
    }
    location ~ ^/api/v1/auth/(signup|login|refresh)$ {
      client_max_body_size 16k;
      limit_req zone=api burst=20 nodelay;
      limit_req zone=auth burst=10 nodelay;
      limit_conn connections 20;
      include /app/proxy.conf;
    }
    location /api/ {
      limit_req zone=api burst=20 nodelay;
      limit_conn connections 20;
      limit_conn uploads 2;
      include /app/proxy.conf;
    }
    location ~ /\. { return 404; }
    location / { try_files $uri $uri/ /index.html; }
  }
}
